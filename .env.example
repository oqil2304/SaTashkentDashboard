# ─── Telegram botlar ─────────────────────────────────────────────────────────
# CLIENT (ta'minotchi) boti tokeni — MAJBURIY
BOT_TOKEN=your_client_bot_token_here

# ADMIN boti tokeni — IXTIYORIY.
# Agar berilsa, ikki bot rejimi yoqiladi: admin va client botlar ALOHIDA jarayonlarda ishlaydi
# (server ichida bot ishga tushmaydi). Berilmasa — bitta bot "both" rejimida ishlaydi.
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Admin Telegram chat ID
ADMIN_CHAT_ID=your_telegram_chat_id_here

# Finance integratsiyasi (ixtiyoriy)
FINANCE_API_URL=https://your-finance-site.com/api/invoice
FINANCE_API_KEY=your_finance_api_key_here

# AI yordamchi (ixtiyoriy) — bo'lmasa bepul kalit-so'zli javob ishlatiladi
ANTHROPIC_API_KEY=
